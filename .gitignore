# --- secrets ---
hf.key
*.key
.env
*.token

# --- model weights and checkpoints (tens of GB, re-downloadable) ---
models/
*.safetensors
*.bin
*.pth
*.gguf
**/teachers/
**/teachers_r1tok/

# --- LoRA adapters (each >100MB for larger students) ---
**/runs/

# --- raw teacher generations and training splits (regenerable, ~220MB) ---
**/cot/
**/splits/lambda*/
**/pilot/*.jsonl

# --- caches and scratch ---
**/cache/
**/smoke/
__pycache__/
*.pyc
.venv/

# --- runs excluded from the study ---
experiments/lambda_lora_bits/sweep_smollm2/
experiments/logs/sweep_smollm2.log
experiments/logs/smollm2_download.log

# --- paper PDFs (see papers/*.md for arXiv links) ---
materials/**/*.pdf
materials/**/*.jpg
materials/**/*.png

# --- benchmark test sets (re-downloadable) ---
experiments/lambda_lora_bits/benchmarks/
# --- raw benchmark generations (gzipped, large) ---
**/bench_raw/

# --- per-adapter evaluation records (1.1 GB; kept in the private HF dataset repo
#     kimtaeyeong1229/cot-distill-teacher-cot under student_generations/, and in the
#     server5 snapshot). The analysis outputs derived from them live in experiments/*.json,
#     which IS tracked, so every number in the paper stays reproducible from this repo. ---
**/eval_val/*.json
**/eval_math500/*.json
**/eval_test/*.json
**/eval_train/*.json
**/eval_aime24/*.json
**/eval_amc23/*.json
**/eval_gpqa_diamond/*.json
**/eval_gsm8k/*.json
**/eval_minervamath/*.json
**/eval_olympiadbench/*.json

# --- upload/transfer progress logs (carriage-return progress bars, no diff value) ---
experiments/logs/hf_upload.log
experiments/logs/backup.log
experiments/logs/recover_pairB_teachers.log
experiments/hf_upload/

# --- tokenizer/config dumps written next to interpolated checkpoints (11 MB each; recreated
#     whenever interpolate.py runs, and the checkpoints themselves are already ignored) ---
**/pilot/teachers_*/
**/view/lambda*/
**/pilot_bad_tokenizer/
**/pilot_instruct_prev/

# --- canary probe training data (30 MB of synthetic mixes, regenerated by canary_data.py) ---
**/canary/data/

# --- pilot-validity generations (110 MB of sampled outputs from the design checks; kept in the
#     server5 snapshot, and pilot_validity.py regenerates them) ---
**/pilot_validity/pi/
**/pilot_validity/canary/
