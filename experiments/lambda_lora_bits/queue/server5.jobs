# 1단계~3단계: 쌍 D 전부 + 쌍 B OLMo seed0. 학습만.
p1-D-qwen0.5b-s12	SEEDS="1 2" STAGES=train STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairD/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
p2-D-llama1b-s012	SEEDS="0 1 2" STAGES=train STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
p3-D-olmo1b-s0	SEEDS="0" STAGES=train MAX_MODEL_LEN=4096 TRAIN_MAX_LEN=4096 TRAIN_TOKEN_BUDGET=8192 STUDENT=models/OLMo-2-1B-Instruct TAG=pairD/olmo1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
e1-D-qwen0.5b-eval	STAGES=eval,eval500 SEEDS="0 1 2" STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairD/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
e2-D-llama1b-eval	STAGES=eval,eval500 SEEDS="0 1 2" STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
h-D-qwen	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairD/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
h-D-llama	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
# 재배분
r-s5-D-llama	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
