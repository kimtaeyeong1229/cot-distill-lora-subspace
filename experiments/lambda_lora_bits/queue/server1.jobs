# leave-one-out regions, pair B moved here from server2/server5 (2026-09-28)
L-a-B-qwen	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_ablation_loo EVAL=eval_ablation_loo LOG=eval_ablation_loo CELLS="pairB/qwen0.5b:Qwen2.5-0.5B-Instruct" bash experiments/lambda_lora_bits/queue/run_ablation.sh
L-s-B-qwen	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_steer_loo EVAL=eval_steer_loo LOG=eval_steer_loo VARIANTS="amp1 amp2 ampn1 ampn4 ampV graft1 graft_rand1 graft_full1 graft_orth1" CELLS="pairB/qwen0.5b:Qwen2.5-0.5B-Instruct" bash experiments/lambda_lora_bits/queue/run_steer.sh
L-a-B-olmo	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_ablation_loo EVAL=eval_ablation_loo LOG=eval_ablation_loo CELLS="pairB/olmo1b:OLMo-2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_ablation.sh
L-s-B-olmo	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_steer_loo EVAL=eval_steer_loo LOG=eval_steer_loo VARIANTS="amp1 amp2 ampn1 ampn4 ampV graft1 graft_rand1 graft_full1 graft_orth1" CELLS="pairB/olmo1b:OLMo-2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_steer.sh
L-a-B-llama	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_ablation_loo EVAL=eval_ablation_loo LOG=eval_ablation_loo CELLS="pairB/llama1b:Llama-3.2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_ablation.sh
L-s-B-llama	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_steer_loo EVAL=eval_steer_loo LOG=eval_steer_loo VARIANTS="amp1 amp2 ampn1 ampn4 ampV graft1 graft_rand1 graft_full1 graft_orth1" CELLS="pairB/llama1b:Llama-3.2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_steer.sh
# beta graft for pair A olmo/llama (2026-09-28)
G-A-olmo	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_graft_beta EVAL=eval_graft_beta LOG=eval_graft_beta VARIANTS="graft2 graft4 graft8 graft_orth2 graft_orth4 graft_orth8 graft_full2 graft_full4 graft_full8" CELLS="sweep_olmo2:OLMo-2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_steer.sh
G-A-llama	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; RUNS=runs_graft_beta EVAL=eval_graft_beta LOG=eval_graft_beta VARIANTS="graft2 graft4 graft8 graft_orth2 graft_orth4 graft_orth8 graft_full2 graft_full4 graft_full8" CELLS="sweep_llama:Llama-3.2-1B-Instruct" bash experiments/lambda_lora_bits/queue/run_steer.sh
