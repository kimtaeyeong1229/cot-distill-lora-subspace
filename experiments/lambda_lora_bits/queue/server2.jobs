# 1단계~3단계: 쌍 A 전부 + 쌍 B OLMo. 학습만.
p1-A-qwen0.5b-s12	SEEDS="1 2" STAGES=train LAMBDAS="0.2 0.4 0.6" STUDENT=models/Qwen2.5-0.5B-Instruct TAG=sweep SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
p2-A-llama1b-s12	SEEDS="1 2" STAGES=train STUDENT=models/Llama-3.2-1B-Instruct TAG=sweep_llama SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
p3-A-olmo1b-s12	SEEDS="1 2" STAGES=train MAX_MODEL_LEN=4096 TRAIN_MAX_LEN=4096 TRAIN_TOKEN_BUDGET=8192 STUDENT=models/OLMo-2-1B-Instruct TAG=sweep_olmo2 SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
e1-A-qwen0.5b-eval	STAGES=eval,eval500 SEEDS="0 1 2" STUDENT=models/Qwen2.5-0.5B-Instruct TAG=sweep SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
e2-A-llama1b-eval	STAGES=eval,eval500 SEEDS="0 1 2" STUDENT=models/Llama-3.2-1B-Instruct TAG=sweep_llama SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
e3-A-olmo1b-eval	STAGES=eval,eval500 SEEDS="0 1 2" MAX_MODEL_LEN=4096 MAX_NEW_TOKENS=3840 STUDENT=models/OLMo-2-1B-Instruct TAG=sweep_olmo2 SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_student.sh
e9-D-llama1b-m500	STAGES=eval500 SEEDS="0 1 2" STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
h-A-qwen	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; STUDENT=models/Qwen2.5-0.5B-Instruct TAG=sweep SPLITS=experiments/lambda_lora_bits/sweep/splits bash experiments/lambda_lora_bits/run_halves.sh
h-B-qwen	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairB/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_halves.sh
# 재배분
r-s2-B-qwen-B	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; HALVES=halfB STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairB/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_halves.sh
r-s2-D-qwen-A	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; HALVES=halfA STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairD/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
r-s2-B-llama-B	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; HALVES=halfB STUDENT=models/Llama-3.2-1B-Instruct TAG=pairB/llama1b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_halves.sh
r-s2-D-llama-B	until [ "$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits|head -1)" -lt 3000 ]; do sleep 120; done; HALVES=halfB STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
