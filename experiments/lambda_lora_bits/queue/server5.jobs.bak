s5-01-wait-C-pilot	until grep -q 'pilot done' experiments/lambda_lora_bits/pairC/pilot.log; do sleep 60; done
s5-02-C-full	PAIR=C STAGE=full TEMPLATE=instruct GPU_UTIL=0.90 bash experiments/lambda_lora_bits/run_pair.sh
s5-03-D-pilot	PAIR=D STAGE=pilot GPU_UTIL=0.90 bash experiments/lambda_lora_bits/run_pair.sh > experiments/lambda_lora_bits/pairD/pilot.log 2>&1
s5-03b-D-pilot-rerun-reasoning	PAIR=D STAGE=pilot GPU_UTIL=0.90 bash experiments/lambda_lora_bits/run_pair.sh > experiments/lambda_lora_bits/pairD/pilot_rerun.log 2>&1
s5-03c-D-pilot-rerun	PAIR=D STAGE=pilot GPU_UTIL=0.90 bash experiments/lambda_lora_bits/run_pair.sh > experiments/lambda_lora_bits/pairD/pilot_rerun2.log 2>&1
s5-04-D-full	PAIR=D STAGE=full TEMPLATE=reasoning GPU_UTIL=0.90 bash experiments/lambda_lora_bits/run_pair.sh > experiments/lambda_lora_bits/pairD/full.log 2>&1
s5-05-sweep-qwen0.5b-D	STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairD/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
s5-06-sweep-qwen1.5b-D	STUDENT=models/Qwen2.5-1.5B-Instruct TAG=pairD/qwen1.5b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
s5-07-sweep-llama1b-D	STUDENT=models/Llama-3.2-1B-Instruct TAG=pairD/llama1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
s5-08-sweep-olmo1b-D	MAX_MODEL_LEN=4096 MAX_NEW_TOKENS=3840 TRAIN_MAX_LEN=4096 STUDENT=models/OLMo-2-1B-Instruct TAG=pairD/olmo1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
s5-09-sweep-qwen3b-D	PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True STUDENT=models/Qwen2.5-3B-Instruct TAG=pairD/qwen3b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
s5-10-sweep-llama3b-D	PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True TRAIN_TOKEN_BUDGET=8192 STUDENT=models/Llama-3.2-3B-Instruct TAG=pairD/llama3b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_student.sh
