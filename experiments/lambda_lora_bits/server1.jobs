# server1 (5070Ti): 쌍 B Llama-1B seed1, 쌍 B OLMo seed1
t1-B-llama1b-s1	SEEDS="1" STAGES=train STUDENT=models/Llama-3.2-1B-Instruct TAG=pairB/llama1b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_student.sh
t2-B-olmo1b-s1	SEEDS="1" STAGES=train MAX_MODEL_LEN=4096 TRAIN_MAX_LEN=4096 TRAIN_TOKEN_BUDGET=6144 STUDENT=models/OLMo-2-1B-Instruct TAG=pairB/olmo1b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_student.sh
e1-B-qwen0.5b-eval	STAGES=eval,eval500 SEEDS="0 1 2" STUDENT=models/Qwen2.5-0.5B-Instruct TAG=pairB/qwen0.5b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_student.sh
e9-B-olmo1b-eval	STAGES=eval,eval500 SEEDS="0 1 2" MAX_MODEL_LEN=4096 MAX_NEW_TOKENS=3840 STUDENT=models/OLMo-2-1B-Instruct TAG=pairB/olmo1b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_student.sh
# 데이터 재표집 기준선 (2칸)
h-B-llama	while pgrep -f 'eval_stud[e]nt.py' >/dev/null; do sleep 120; done; STUDENT=models/Llama-3.2-1B-Instruct TAG=pairB/llama1b SPLITS=experiments/lambda_lora_bits/pairB/splits bash experiments/lambda_lora_bits/run_halves.sh
h-D-olmo	while pgrep -f 'eval_stud[e]nt.py' >/dev/null; do sleep 120; done; MAX_MODEL_LEN=4096 TRAIN_MAX_LEN=4096 TRAIN_TOKEN_BUDGET=4096 STUDENT=models/OLMo-2-1B-Instruct TAG=pairD/olmo1b SPLITS=experiments/lambda_lora_bits/pairD/splits bash experiments/lambda_lora_bits/run_halves.sh
